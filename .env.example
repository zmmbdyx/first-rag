# ===== 大模型服务（OpenAI 兼容接口）=====
# 密钥只放在 .env（已被 .gitignore 排除），切勿写进代码或提交到仓库！

# ---------- 默认端点（必填）----------
API_KEY=sk-你的密钥
BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
JUDGE_MODEL=deepseek-chat

# ---------- 附加端点（可选，多厂商混用时配置） ----------
# 命名规则：别名(自定义,建议大写) + 双下划线 + BASE_URL / API_KEY
# DEEPSEEK__BASE_URL=https://api.deepseek.com
# DEEPSEEK__API_KEY=sk-xxx
# ALIYUN__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ALIYUN__API_KEY=sk-xxx
# ZHIPU__BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU__API_KEY=sk-xxx

# ---------- 模型清单（Web 界面下拉框；逗号分隔） ----------
# 不带 @ 的模型走默认端点；带 @ 的走对应别名端点（模型名@别名）
# MODEL_OPTIONS=deepseek-chat,deepseek-v4-pro@aliyun,qwen-plus@aliyun,glm-4-flash@zhipu
#
# CLI 指定模型：python scripts/ask.py "问题" --model "deepseek-v4-pro@aliyun"
# 评测判分模型也可跨端点：JUDGE_MODEL=deepseek-chat@deepseek

# 其他 OpenAI 兼容端点参考：
#   阿里云百炼:  BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   智谱:        BASE_URL=https://open.bigmodel.cn/api/paas/v4                LLM_MODEL=glm-4-flash
#   火山方舟:    BASE_URL=https://ark.cn-beijing.volces.com/api/v3            LLM_MODEL=doubao-pro-32k

# ===== 嵌入模型（本地运行，无需联网调用）=====
EMBED_MODEL=shibing624/text2vec-base-chinese

# ===== 检索与切分（可选，默认值见 rag/config.py）=====
# RETRIEVAL_MODE=hybrid      # vector | keyword | hybrid
# CHUNK_SIZE=420
# FINAL_TOP_K=5

# ===== Redis 问答缓存（可选）=====
# 未安装 redis 或连不上时自动降级：每次请求走完整链路，不影响可用性。
# 容器内运行（docker compose）时由 compose 注入 redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=auto # auto：能连上就启用 | on：必须启用（连不上会告警）| off：关闭
CACHE_TTL=1800 # 缓存有效期（秒）
CACHE_PREFIX=rag:qa

# ===== 异步入库（可选）=====
INGEST_WORKERS=4 # 解析并发度
ASYNC_INGEST=1 # 1=asyncio+线程池；0=线程池

# ===== 服务化 API（可选）=====
# API_KEYS 为空表示不鉴权（仅建议本地开发）；生产请设置，逗号分隔支持多把 key
# API_KEYS=sk-your-service-key
# API_PORT=8000


# ===== 前后端分离后端 backend/（v3.0 新增）=====
# 注意：大模型 / Embedding / 向量库 / 检索 等配置**复用上面已有的变量**，
# 这里只列后端专属的新增配置。全部有默认值，本地开发可整段不填。

# HOST=0.0.0.0
# PORT=8000

# 会话数据库：默认 SQLite（文件已被 .gitignore 排除）
# 换 PostgreSQL 时形如（把尖括号换成真实值，切勿把真实口令提交进仓库）：
# DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@<db_host>:5432/rag
# DATABASE_URL=sqlite:///./backend/data/conversations.db

# 上传文件落盘目录（已被 .gitignore 排除）
# UPLOAD_DIR=backend/uploads
# 单文件大小上限（MB）
# MAX_UPLOAD_MB=50
# 上传后是否立即向量化入库；设为 false 则只保存文件，之后再手动入库
# INGEST_ON_UPLOAD=true

# CORS 白名单：允许访问后端的前端地址，逗号分隔
# 用 Vite 开发服务器默认端口时无需修改；前端独立域名部署时改成真实域名
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 服务端鉴权：逗号分隔支持多把密钥；**留空 = 不鉴权**（本地开发零配置）。
# 配置后，除 /api/health（供健康探针豁免）外的所有 /api/* 都要求携带
#   Authorization: Bearer <key>   或   X-API-Key: <key>
# 前端通过构建期变量注入同一把密钥：VITE_API_KEY=<key> npm run build
# （生产更推荐让 Nginx 在反代时注入 Authorization 头，密钥就不必打进前端产物）
# API_KEYS=sk-your-service-key

# 参与改写与生成的最近对话轮数（1 轮 = 一问一答）
# HISTORY_ROUNDS=3
# 会话标题取首条消息的前 N 字
# TITLE_MAX_LEN=20
# 默认送入大模型的片段数
# DEFAULT_TOP_K=5


# ===== 文档级权限 ACL（v3.1 新增，生产建议开启严格模式）=====
# 每个 chunk 入库时带 perm_tags 标签；检索按请求头里的用户组过滤。
#   RAG_ACL_ENABLED=1  检索时启用权限过滤
#   RAG_ACL_STRICT=1   严格模式：**未打标签的 chunk 对普通用户不可见**（fail-closed）
#   RAG_ACL_DEFAULT_TAGS  未显式指定标签时的默认值
#   RAG_ACL_OVERSAMPLE    开启过滤时的召回放大倍数（抵消过滤造成的名额损失）
#   RAG_ACL_ADMIN_TAG     拥有该标签的用户组可见全部文档
#
# ⚠️ 迁移提示：升级前入库的 chunk 没有标签，宽松模式下等同公开。
#    开启 STRICT 前请先 GET /api/documents 看 untagged_count，
#    再逐份 PUT /api/documents/{name}/tags 归类（或 dry-run 后 backfill）。
# RAG_ACL_ENABLED=1
# RAG_ACL_STRICT=1
# RAG_ACL_DEFAULT_TAGS=public
# RAG_ACL_OVERSAMPLE=3
# RAG_ACL_ADMIN_TAG=admin

# 用户组 / 用户标识的请求头名。**必须由可信网关注入并覆盖**客户端同名头，
# 否则客户端可伪造成任意组，ACL 形同虚设（详见 README 第 10.6 节）。
# ACL_GROUPS_HEADER=X-User-Groups
# ACL_USER_HEADER=X-User-Id

# 管理接口专用密钥（文档清单/改密级/删除/上传）。与 API_KEYS 分开：
# 问答密钥不应具备删库能力。留空表示不校验（仅本地开发）。
# ADMIN_KEYS=sk-your-admin-key


# ===== 相关性阈值与分级拒答（v3.1 新增）=====
# 依据重排分数（sigmoid 后的相关概率）分档：
#   >= RAG_ANSWER_THRESHOLD   直接作答
#   >= RAG_CAUTION_THRESHOLD  作答但前端提示"仅供参考"
#   <  RAG_CAUTION_THRESHOLD  **不调用大模型**，直接拒答并给出建议
# 置为空串表示不做门限（退回旧行为：完全依赖提示词让模型自觉拒答）。
# RAG_ANSWER_THRESHOLD=0.35
# RAG_CAUTION_THRESHOLD=0.15


# ===== 审计日志（PII 与保留期，v3.1 新增）=====
# 落盘前对手机号/身份证/邮箱/银行卡/API Key/私钥/IP 做掩码，并按天分文件。
# AUDIT_ENABLED=1
# AUDIT_REDACT=1
# 设为 0 则只存长度与哈希、**完全不落原文**（合规最强档，但排障变弱）
# AUDIT_STORE_TEXT=1
# 保留期（天），超期文件由 rag.audit.purge_expired() 清理
# AUDIT_RETENTION_DAYS=90


# ===== 重排调优（v3.1 新增）=====
# 早停：第 1 名领先第 2 名超过该分差则认为顺序已稳定，跳过剩余候选计算。
# 默认 0 表示不早停。重排是端到端延迟的主要来源（实测约 3.5s/题），
# 降低 RERANK_CANDIDATES 或启用早停是性价比最高的优化手段。
# RERANK_CANDIDATES=10
# RERANK_EARLY_STOP_MARGIN=0.0

