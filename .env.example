# ===== 大模型服务（OpenAI 兼容接口）=====
# 密钥只放在 .env（已被 .gitignore 排除），切勿写进代码或提交到仓库！

# ---------- 默认端点（必填）----------
API_KEY=sk-你的密钥
BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
JUDGE_MODEL=deepseek-chat

# ---------- 附加端点（可选，多厂商混用时配置） ----------
# 命名规则：别名(自定义,建议大写) + 双下划线 + BASE_URL / API_KEY
# DEEPSEEK__BASE_URL=https://api.deepseek.com
# DEEPSEEK__API_KEY=sk-xxx
# ALIYUN__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ALIYUN__API_KEY=sk-xxx
# ZHIPU__BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU__API_KEY=sk-xxx

# ---------- 模型清单（Web 界面下拉框；逗号分隔） ----------
# 不带 @ 的模型走默认端点；带 @ 的走对应别名端点（模型名@别名）
# MODEL_OPTIONS=deepseek-chat,deepseek-v4-pro@aliyun,qwen-plus@aliyun,glm-4-flash@zhipu
#
# CLI 指定模型：python scripts/ask.py "问题" --model "deepseek-v4-pro@aliyun"
# 评测判分模型也可跨端点：JUDGE_MODEL=deepseek-chat@deepseek

# 其他 OpenAI 兼容端点参考：
#   阿里云百炼:  BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   智谱:        BASE_URL=https://open.bigmodel.cn/api/paas/v4                LLM_MODEL=glm-4-flash
#   火山方舟:    BASE_URL=https://ark.cn-beijing.volces.com/api/v3            LLM_MODEL=doubao-pro-32k

# ===== 嵌入模型（本地运行，无需联网调用）=====
EMBED_MODEL=shibing624/text2vec-base-chinese

# ===== 检索与切分（可选，默认值见 rag/config.py）=====
# RETRIEVAL_MODE=hybrid      # vector | keyword | hybrid
# CHUNK_SIZE=420
# FINAL_TOP_K=5

# ===== Redis 问答缓存（可选）=====
# 未安装 redis 或连不上时自动降级：每次请求走完整链路，不影响可用性。
# 容器内运行（docker compose）时由 compose 注入 redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=auto # auto：能连上就启用 | on：必须启用（连不上会告警）| off：关闭
CACHE_TTL=1800 # 缓存有效期（秒）
CACHE_PREFIX=rag:qa

# ===== 异步入库（可选）=====
INGEST_WORKERS=4 # 解析并发度
ASYNC_INGEST=1 # 1=asyncio+线程池；0=线程池

# ===== 服务化 API（可选）=====
# API_KEYS 为空表示不鉴权（仅建议本地开发）；生产请设置，逗号分隔支持多把 key
# API_KEYS=sk-your-service-key
# API_PORT=8000


# ===== 前后端分离后端 backend/（v3.0 新增）=====
# 注意：大模型 / Embedding / 向量库 / 检索 等配置**复用上面已有的变量**，
# 这里只列后端专属的新增配置。全部有默认值，本地开发可整段不填。

# HOST=0.0.0.0
# PORT=8000

# 会话数据库：默认 SQLite（文件已被 .gitignore 排除）
# 换 PostgreSQL 时形如（把尖括号换成真实值，切勿把真实口令提交进仓库）：
# DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@<db_host>:5432/rag
# DATABASE_URL=sqlite:///./backend/data/conversations.db

# 上传文件落盘目录（已被 .gitignore 排除）
# UPLOAD_DIR=backend/uploads
# 单文件大小上限（MB）
# MAX_UPLOAD_MB=50
# 上传后是否立即向量化入库；设为 false 则只保存文件，之后再手动入库
# INGEST_ON_UPLOAD=true

# CORS 白名单：允许访问后端的前端地址，逗号分隔
# 用 Vite 开发服务器默认端口时无需修改；前端独立域名部署时改成真实域名
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 参与改写与生成的最近对话轮数（1 轮 = 一问一答）
# HISTORY_ROUNDS=3
# 会话标题取首条消息的前 N 字
# TITLE_MAX_LEN=20
# 默认送入大模型的片段数
# DEFAULT_TOP_K=5

