# ===== 密钥与环境变量（严禁提交）=====
.env
.env.*
# 模板文件要提交：根目录与 frontend/ 各一份。前端那份在子目录里，
# 单独放行一次（`.env.*` 会把它一起吞掉）。
!**/.env.example
!.env.example
!frontend/.env.example

# ===== 向量库 / 索引 / 评测缓存 =====
chroma_db/
data/index/
data/uploads/
eval/.eval_db/
logs/
*.pkl
data/.cache/

# ===== Python =====
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/

# ===== 会话数据库（前后端分离后新增，含用户提问记录）=====
*.db
*.sqlite
*.sqlite3
backend/data/

# ===== 用户上传的文件 =====
backend/uploads/

# ===== 前端（React + Vite）=====
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 系统与临时文件 =====
.DS_Store
Thumbs.db
*.log*

# ===== IDE / 编辑器 =====
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~

# ===== 本地工具与基准临时目录（如本地 Redis、放大语料）=====
.tools/
.bench_big/

# ===== 测试与验收产物 =====
.coverage
htmlcov/
playwright-report/
test-results/
